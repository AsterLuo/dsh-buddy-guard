{
  "name": "dsh-buddy-guard",
  "version": "0.1.0",
  "type": "module",
  "description": "Fix CodeBuddy (Tencent) channel returning 400 'Illegal API invocation from an unapproved channel' in DeepSeek Harness by prefixing a space to the system prompt.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check lib/index.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "codebuddy",
    "buddy",
    "workbuddy",
    "deepseek"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AsterLuo/dsh-buddy-guard.git"
  },
  "homepage": "https://github.com/AsterLuo/dsh-buddy-guard#readme",
  "bugs": {
    "url": "https://github.com/AsterLuo/dsh-buddy-guard/issues"
  },
  "author": "AsterLuo",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
